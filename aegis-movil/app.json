{
  "expo": {
    "name": "aegis-movil",
    "slug": "aegis-movil",
    "version": "1.0.0",
    "scheme": "aegis-movil",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.anonymous.aegismovil"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/bootsplash/logoAegis.png",
          "imageWidth": 100,
          "backgroundColor": "#232323",
          "dark": {
            "image": "./assets/bootsplash/logo-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ]
  }
}
